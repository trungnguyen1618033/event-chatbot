#  ── LLM provider switch ──────────────────────────────────────
#  "openai" → api.openai.com           | "bedrock" → OpenAI-compatible proxy
#  "azure"  → Azure OpenAI full-URL    | "gemini"  → Google Gemini (free tier)
LLM_PROVIDER=openai

#  ── OpenAI (api.openai.com) ──────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

#  ── Bedrock (used when LLM_PROVIDER=bedrock) ─────────────────
BEDROCK_API_KEY=
BEDROCK_BASE_URL=
BEDROCK_MODEL=

#  ── Azure OpenAI (used when LLM_PROVIDER=azure) ──────────────
#  AZURE_OPENAI_ENDPOINT must be the FULL URL including deployment + api-version:
#  https://<resource>.openai.azure.com/openai/deployments/<dep>/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=

#  ── Google Gemini (used when LLM_PROVIDER=gemini, free tier) ─
#  Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL is set automatically; override only for custom deployments

#  PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_chatbot
DB_USER=postgres
DB_PASSWORD=postgres

#  ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=chat_history

#  App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
